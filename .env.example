# Ask the Archive (/api/ask). Copy to .env.local for local dev.
# Server-only: never prefix these with NEXT_PUBLIC_.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
RAG_CORPUS=projects/<number>/locations/us-central1/ragCorpora/<id>
GEMINI_MODEL=gemini-3.8-flash
# Gemini endpoint. Newer models are served only from "global".
GEMINI_LOCATION=global
# Optional: force score direction once verified ("similarity" or "distance").
RAG_SCORE_KIND=

# Auth needs no keys (the org policy blocks service account keys).
# Locally: run `gcloud auth application-default login` once.
# On Vercel only, for Workload Identity Federation (see docs/deploy-vercel.md):
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=
